# Copy to .env (gitignored) and fill in. See README "Getting started" for
# what each of these does and how to get a value for it.

# === Environment ===

# Read by the Makefile (not docker-compose.yml) to pick which compose files
# to layer - "development" (default) keeps today's live-editing workflow via
# docker-compose.dev.yml; "production" runs docker-compose.yml alone, with
# no source/config bind mounts. See README "Start the stack".
ENVIRONMENT=development

# Read by every Python service's own logging.basicConfig() (see AGENTS.md) -
# one shared knob, not per-service-prefixed like most other vars, since the
# same override should apply identically everywhere. DEBUG/INFO/WARNING/
# ERROR/CRITICAL; invalid values fail loudly at container startup rather
# than silently falling back.
# LOG_LEVEL=INFO

# === Core stack (required) ===

# Required by docker-compose.yml - admin credential for LiteLLM's own /ui
# and /key/generate. Pick anything reasonably secret; it's never sent to
# Anthropic/OpenAI.
LITELLM_MASTER_KEY=

# Required by docker-compose.yml - Postgres password for LiteLLM's own
# virtual-keys/budgets database.
LITELLM_DB_PASSWORD=

# Required by docker-compose.yml - five least-privilege ClickHouse identities,
# each SQL-managed once by `make init` (CREATE USER OR REPLACE + its own
# grants) using the bootstrap credentials below - not re-applied on every
# startup; clickhouse-migrate never touches users/roles/grants at all, only
# services/clickhouse/migrations/*.sql. Prefer `make init` over filling these
# in by hand - it prompts for each one (with these names as suggested
# defaults) and writes them here for you. See services/init/config.yml for
# exactly what each role can/can't do, and README "Configuration" for the
# full two-tier setup.
CLICKHOUSE_DATABASE=default

# webhook/webhook-worker/webhook-reparse - INSERT on the whole database plus
# a narrow SELECT list (see services/init/config.yml). Never SELECT on most tables.
CLICKHOUSE_INGEST_USER=ingest
CLICKHOUSE_INGEST_PASSWORD=

# grafana - read-only (SELECT on the database plus system.tables).
CLICKHOUSE_GRAFANA_USER=grafana
CLICKHOUSE_GRAFANA_PASSWORD=

# mcp-dev (dev-only) - read-only (SELECT on the database plus system.query_log +
# SYSTEM FLUSH LOGS, for the `profile_query` tool).
CLICKHOUSE_MCP_USER=mcp
CLICKHOUSE_MCP_PASSWORD=

# mcp-stats - read-only, scoped to agent_usage only (the one table `whatsup` reads).
CLICKHOUSE_MCP_STATS_USER=mcp_stats
CLICKHOUSE_MCP_STATS_PASSWORD=

# backup (backup_clickhouse.sh) - BACKUP privilege only, no SELECT/INSERT.
CLICKHOUSE_BACKUP_USER=backup
CLICKHOUSE_BACKUP_PASSWORD=

# loadtest - full (ALL) rights, but only on its own dedicated
# CLICKHOUSE_LOADTEST_DATABASE below, never on CLICKHOUSE_DATABASE.
CLICKHOUSE_LOADTEST_USER=loadtest
CLICKHOUSE_LOADTEST_PASSWORD=

# Required by docker-compose.yml - dedicated database load tests write into,
# kept separate from CLICKHOUSE_DATABASE so a load test never touches real
# data. Created once by `make init`, never by loadtest-runner - it only
# checks the database already exists before every run and alerts if it
# doesn't, then wipes it clean (safe: it never holds real data).
CLICKHOUSE_LOADTEST_DATABASE=loadtest

# Required by docker-compose.yml - superuser the ClickHouse image itself
# provisions (CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1), used only to bootstrap
# the five roles above via SQL. Never used by application services directly
# (restore_clickhouse.sh is the one exception - see README "Backup & restore").
CLICKHOUSE_BOOTSTRAP_USER=clickhouse_bootstrap
CLICKHOUSE_BOOTSTRAP_PASSWORD=

# Breaking change from the old single CLICKHOUSE_USER/CLICKHOUSE_PASSWORD
# model: if you have an existing .env from before this, replace that pair
# with the five role pairs above (`make init` will do this for you).

# === Ports & host overrides (optional) ===

# Published host ports for the seven services `load-balancer` (nginx) fronts.
# Only needed if a default collides with something else already running on
# your host - the container-internal port stays fixed either way, see README
# "Gateway (load-balancer)".
# WEBHOOK_PORT=8010
# LITELLM_PORT=4000
# GRAFANA_PORT=3000
# MCP_SERVER_PORT=8001
# CLICKHOUSE_HTTP_PORT=8123
# CLICKHOUSE_NATIVE_PORT=9000
# PROMETHEUS_PORT=9090

# litellm-with-fallback ports (also fronted by load-balancer) - proxy
# straight to litellm normally, fall over to api.anthropic.com/api.openai.com
# if litellm doesn't respond. See "Gateway (load-balancer)" in README.md.
# ANTHROPIC_PROXY_PORT=4001
# OPENAI_PROXY_PORT=4002

# Full LiteLLM proxy URI, in case it isn't reachable at localhost (a
# shared/remote host) - takes precedence over LITELLM_PORT above wherever a
# URL is needed (e.g. `make setup-client`'s printed config). Not read by
# docker-compose.yml at all - Makefile-only, same as AGENT_CLI_TRACKING_API_URL
# below.
# LITELLM_URI=http://localhost:4000

# Same override pattern as LITELLM_URI above, for ANTHROPIC_PROXY_PORT/
# OPENAI_PROXY_PORT - only needed on a shared/remote host.
# ANTHROPIC_PROXY_URI=http://localhost:4001
# OPENAI_PROXY_URI=http://localhost:4002

# === Backup (optional) ===

# Host-side root directory the `backup` service (services/backup/, see
# README "Backup & restore") reads/writes. Defaults to .backups/ next to
# this file if unset.
# BACKUP_DIR=.backups

# Remote model sources (Ollama, a reranker, etc.) are NOT configured here -
# they're plain LiteLLM config files under services/litellm/user_configs/,
# not env vars. See services/litellm/user_configs/config.yaml.tmpl and
# "Remote model sources" under "LiteLLM" in README.md.

# === Personal / `make setup-client` convenience (auto-populated) ===

# Auto-provisioned by `make init` (services/init/init_litellm_key.py): a
# default Team and a personal virtual key with access to every model,
# created via LiteLLM's own Admin API. Not read by docker-compose.yml at
# all - purely so `make setup-client` can substitute your personal virtual
# key into its printed output instead of a `<virtual key>` placeholder
# you'd otherwise hand-edit in. Gitignored like the rest of this file, so
# it's safe to have a real key here. See "Issue yourself a personal key" /
# "Configuring via config files instead of shell exports" under "LiteLLM"
# in README.md.
LITELLM_TEAM_ID=
LITELLM_VIRTUAL_KEY=

# === Langfuse (optional, self-hosted observability) ===
# Own Postgres/ClickHouse/Redis/MinIO, all separate from the agent-tracking
# stack above - see "Langfuse" in README.md. Required by docker-compose.yml:

# Optional - published host ports, same as WEBHOOK_PORT/etc. above.
# LANGFUSE_PORT=3001
# LANGFUSE_CLICKHOUSE_HTTP_PORT=8124
# LANGFUSE_CLICKHOUSE_NATIVE_PORT=9001

LANGFUSE_CLICKHOUSE_USER=langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_DB_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_ROOT_USER=minio
LANGFUSE_MINIO_ROOT_PASSWORD=
# `openssl rand -hex 16`
LANGFUSE_SALT=
# `openssl rand -hex 32` - exactly 64 hex chars, Langfuse refuses to boot otherwise.
LANGFUSE_ENCRYPTION_KEY=
# `openssl rand -hex 32`
LANGFUSE_NEXTAUTH_SECRET=

# Auto-provisions an org/project/admin user on langfuse-web's first boot
# (LANGFUSE_INIT_* - https://langfuse.com/self-hosting/configuration) so
# there's a working project and API-key pair with no manual /setup step.
LANGFUSE_INIT_ORG_ID=receipt-goblin
LANGFUSE_INIT_ORG_NAME=Receipt Goblin
LANGFUSE_INIT_PROJECT_ID=agent-tracking
LANGFUSE_INIT_PROJECT_NAME=agent-tracking
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=

# LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY (what litellm authenticates to
# Langfuse with) MUST be byte-for-byte identical to
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY below - the INIT_PROJECT_* vars
# are what makes Langfuse create exactly that key pair for the auto-provisioned
# project, they aren't separately-issued credentials. Public keys start
# `pk-lf-`, secret keys `sk-lf-`, both followed by a random hex string
# (e.g. `pk-lf-$(openssl rand -hex 16)`).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
