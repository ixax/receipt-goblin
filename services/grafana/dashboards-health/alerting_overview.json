{
  "apiVersion": "dashboard.grafana.app/v2beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "alerting-overview"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Tooltip",
    "description": "LiteLLM native alerts (budget/outage/exception/hang signals) alongside our own derived reliability metrics (error rate, latency, spend, ingest pipeline health) - the dashboard the llm-alerts alert rules (services/grafana/provisioning/alerting/rules.yml) are conceptually about.",
    "editable": true,
    "elements": {
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Error rate by model over time",
          "description": "Goal: spot which model is driving up API-level failures right now, not just the aggregate error rate.\nDescription: joins agent_events to agent_usage on litellm_call_id (unique per call) to attach a model to each event, buckets into 5-minute intervals, and computes failures / total calls per model per bucket.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "version": "v0",
                      "group": "grafana-clickhouse-datasource",
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 0,
                        "rawSql": "SELECT\n  toStartOfInterval(e.timestamp, INTERVAL 5 MINUTE) AS time,\n  u.model AS metric,\n  countIf(e.status = 'failure') / nullIf(count(), 0) AS value\nFROM agent_events e\nINNER JOIN agent_usage u ON e.litellm_call_id = u.litellm_call_id\nWHERE $__timeFilter(e.timestamp)\n  AND e.litellm_call_id != ''\nGROUP BY time, metric\nORDER BY time"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "pluginVersion": "13.1.0",
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "list",
                  "placement": "right"
                },
                "tooltip": {
                  "mode": "multi"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 10,
                    "spanNulls": false,
                    "showPoints": "never",
                    "pointSize": 5,
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "displayName": "${__field.labels.metric}"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Error rate by provider over time",
          "description": "Goal: tell whether a spike in failures is provider-wide (an upstream outage) or isolated to one model within a provider.\nDescription: same join/bucketing as \"Error rate by model over time\" but grouped by agent_usage.provider (claude/openai/other) instead of the individual model.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "version": "v0",
                      "group": "grafana-clickhouse-datasource",
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 0,
                        "rawSql": "SELECT\n  toStartOfInterval(e.timestamp, INTERVAL 5 MINUTE) AS time,\n  u.provider AS metric,\n  countIf(e.status = 'failure') / nullIf(count(), 0) AS value\nFROM agent_events e\nINNER JOIN agent_usage u ON e.litellm_call_id = u.litellm_call_id\nWHERE $__timeFilter(e.timestamp)\n  AND e.litellm_call_id != ''\nGROUP BY time, metric\nORDER BY time"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "pluginVersion": "13.1.0",
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "list",
                  "placement": "right"
                },
                "tooltip": {
                  "mode": "multi"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 10,
                    "spanNulls": false,
                    "showPoints": "never",
                    "pointSize": 5,
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "displayName": "${__field.labels.metric}"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Latency p95 by model over time",
          "description": "Goal: see whether one model is dragging p95 latency up, since a slow-but-rare model can hide inside an all-model average.\nDescription: joins agent_events to agent_usage on litellm_call_id to attach a model to each call, buckets into 5-minute intervals, and computes quantile(0.95)(latency_ms) per model per bucket.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "version": "v0",
                      "group": "grafana-clickhouse-datasource",
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 0,
                        "rawSql": "SELECT\n  toStartOfInterval(e.timestamp, INTERVAL 5 MINUTE) AS time,\n  u.model AS metric,\n  quantile(0.95)(e.latency_ms) AS value\nFROM agent_events e\nINNER JOIN agent_usage u ON e.litellm_call_id = u.litellm_call_id\nWHERE $__timeFilter(e.timestamp)\n  AND e.litellm_call_id != ''\n  AND e.latency_ms IS NOT NULL\nGROUP BY time, metric\nORDER BY time"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "pluginVersion": "13.1.0",
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "list",
                  "placement": "right"
                },
                "tooltip": {
                  "mode": "multi"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 10,
                    "spanNulls": false,
                    "showPoints": "never",
                    "pointSize": 5,
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "displayName": "${__field.labels.metric}"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Latency p99 by model over time",
          "description": "Goal: catch tail-latency outliers per model that p95 alone can smooth over.\nDescription: same join/bucketing as the p95 panel, computing quantile(0.99)(latency_ms) per model per bucket instead.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "version": "v0",
                      "group": "grafana-clickhouse-datasource",
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 0,
                        "rawSql": "SELECT\n  toStartOfInterval(e.timestamp, INTERVAL 5 MINUTE) AS time,\n  u.model AS metric,\n  quantile(0.99)(e.latency_ms) AS value\nFROM agent_events e\nINNER JOIN agent_usage u ON e.litellm_call_id = u.litellm_call_id\nWHERE $__timeFilter(e.timestamp)\n  AND e.litellm_call_id != ''\n  AND e.latency_ms IS NOT NULL\nGROUP BY time, metric\nORDER BY time"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "pluginVersion": "13.1.0",
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "list",
                  "placement": "right"
                },
                "tooltip": {
                  "mode": "multi"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 10,
                    "spanNulls": false,
                    "showPoints": "never",
                    "pointSize": 5,
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "displayName": "${__field.labels.metric}"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Spend trend (cost over time)",
          "description": "Goal: watch overall spend trend so a budget alert (see litellm_alerts row above) can be read against the spend that actually caused it.\nDescription: buckets agent_usage into 5-minute intervals and sums LiteLLM-reported cost per bucket - no local pricing math, cost comes straight from LiteLLM's own response_cost - and overlays a second series counting litellm_alerts rows per bucket whose event looks budget/threshold-related, so a spend spike can be read against when a budget alert actually fired.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "version": "v0",
                      "group": "grafana-clickhouse-datasource",
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 0,
                        "rawSql": "SELECT\n  toStartOfInterval(timestamp, INTERVAL 5 MINUTE) AS time,\n  sum(cost) AS value\nFROM agent_usage\nWHERE $__timeFilter(timestamp)\nGROUP BY time\nORDER BY time"
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "B",
                    "query": {
                      "kind": "DataQuery",
                      "version": "v0",
                      "group": "grafana-clickhouse-datasource",
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 0,
                        "rawSql": "SELECT\n  toStartOfInterval(received_at, INTERVAL 5 MINUTE) AS time,\n  count() AS budget_alerts\nFROM litellm_alerts\nWHERE $__timeFilter(received_at)\n  AND (positionCaseInsensitive(event, 'budget') > 0 OR positionCaseInsensitive(event, 'threshold') > 0)\nGROUP BY time\nORDER BY time"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "pluginVersion": "13.1.0",
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "list",
                  "placement": "right"
                },
                "tooltip": {
                  "mode": "multi"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 10,
                    "spanNulls": false,
                    "showPoints": "never",
                    "pointSize": 5,
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "value"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "mode": "fixed",
                          "fixedColor": "blue"
                        }
                      },
                      {
                        "id": "displayName",
                        "value": "cost"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "budget_alerts"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "mode": "fixed",
                          "fixedColor": "white"
                        }
                      },
                      {
                        "id": "custom.axisPlacement",
                        "value": "right"
                      },
                      {
                        "id": "custom.drawStyle",
                        "value": "points"
                      },
                      {
                        "id": "custom.pointSize",
                        "value": 8
                      },
                      {
                        "id": "unit",
                        "value": "short"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Ingest DLQ row count",
          "description": "Goal: give the currently-unconsumed ingest_dlq dead-letter feed an at-a-glance signal that something needs triage.\nDescription: counts ingest_dlq rows (rejected agent_events/agent_usage/etc. inserts) in the selected time range - any non-zero value means a batch failed to land and needs the table below to diagnose.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "version": "v0",
                      "group": "grafana-clickhouse-datasource",
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 0,
                        "rawSql": "SELECT count() AS dlq_count\nFROM ingest_dlq\nWHERE $__timeFilter(occurred_at)"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "pluginVersion": "13.1.0",
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "custom": {},
                  "mappings": [],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      },
                      {
                        "color": "red",
                        "value": 1
                      }
                    ]
                  },
                  "unit": "locale"
                },
                "overrides": []
              },
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "auto",
                "showPercentChange": false
              }
            }
          }
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Ingest DLQ recent rows",
          "description": "Goal: give the ingest_dlq dead-letter feed (currently unconsumed anywhere else per its own schema comment) an actual triage view instead of sitting write-only.\nDescription: lists the most recent 100 ingest_dlq rows (which target table rejected the insert, the error, and the offending litellm_call_id/session_id/raw_row) ordered newest first; raw_row is the full JSON of the rejected row, shown via the inspect drawer rather than a fixed-width column.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "version": "v0",
                      "group": "grafana-clickhouse-datasource",
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "rawSql": "SELECT occurred_at, stage, litellm_call_id, session_id, error, raw_row\nFROM ingest_dlq\nWHERE $__timeFilter(occurred_at)\nORDER BY occurred_at DESC\nLIMIT 100"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "pluginVersion": "13.1.0",
              "options": {
                "showHeader": true,
                "sortBy": [
                  {
                    "displayName": "occurred_at",
                    "desc": true
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "occurred_at"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 170
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "stage"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 150
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "session_id"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 130
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "error"
                    },
                    "properties": [
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "auto"
                        }
                      },
                      {
                        "id": "custom.inspect",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "raw_row"
                    },
                    "properties": [
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "auto"
                        }
                      },
                      {
                        "id": "custom.inspect",
                        "value": true
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Recent LiteLLM alerts",
          "description": "Goal: surface LiteLLM's own budget/outage/exception/hang signals (things our generic_api StandardLoggingPayload callback cannot reconstruct) as soon as they fire.\nDescription: lists the most recent 100 litellm_alerts rows newest first, with event as a visible sortable column so a viewer can scan/filter by alert type; raw_payload (full JSON, shape varies per alert type) is shown via the inspect drawer rather than a fixed-width column.",
          "links": [],
          "transparent": false,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "version": "v0",
                      "group": "grafana-clickhouse-datasource",
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "rawSql": "SELECT received_at, event, event_group, key_alias, team_id, user_id, spend, max_budget, event_message, raw_payload\nFROM litellm_alerts\nWHERE $__timeFilter(received_at)\nORDER BY received_at DESC\nLIMIT 100"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "pluginVersion": "13.1.0",
              "options": {
                "showHeader": true,
                "sortBy": [
                  {
                    "displayName": "received_at",
                    "desc": true
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "received_at"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 170
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "event"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 150
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "event_group"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 130
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "spend"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "currencyUSD"
                      },
                      {
                        "id": "custom.width",
                        "value": 100
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "max_budget"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "currencyUSD"
                      },
                      {
                        "id": "custom.width",
                        "value": 100
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "event_message"
                    },
                    "properties": [
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "auto"
                        }
                      },
                      {
                        "id": "custom.inspect",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "raw_payload"
                    },
                    "properties": [
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "auto"
                        }
                      },
                      {
                        "id": "custom.inspect",
                        "value": true
                      }
                    ]
                  }
                ]
              }
